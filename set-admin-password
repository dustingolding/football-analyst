#!/usr/bin/env bash
# Set the /admin (newsroom) password for dev or prod and restart the web app so it takes effect.
#
#   ./set-admin-password prod      # sidelinewire.com/admin
#   ./set-admin-password dev       # dev.sidelinewire.com/admin
#
# Prompts twice without echoing, so nothing is copied from the terminal. Signing in again is required afterwards.
set -euo pipefail
ENV_NAME="${1:-}"
if [[ "$ENV_NAME" != "dev" && "$ENV_NAME" != "prod" ]]; then
    echo "usage: $0 dev|prod" >&2
    exit 2
fi
cd "$(dirname "$0")"
export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"
NAMESPACE="$(. "deploy/${ENV_NAME}.env" && echo "$NAMESPACE")"

read -r -s -p "New admin password for ${ENV_NAME}: " pw1; echo
read -r -s -p "Type it again: " pw2; echo
if [[ "$pw1" != "$pw2" ]]; then
    echo "The two entries don't match; nothing changed." >&2
    exit 1
fi
if (( ${#pw1} < 12 )); then
    echo "Use at least 12 characters; nothing changed." >&2
    exit 1
fi
kubectl -n "$NAMESPACE" create secret generic newsroom --from-literal=password="$pw1" --dry-run=client -o yaml \
    | kubectl apply -f - >/dev/null
unset pw1 pw2
kubectl -n "$NAMESPACE" rollout restart deployment/web >/dev/null
kubectl -n "$NAMESPACE" rollout status deployment/web --timeout=180s
echo "Done. Sign in at /admin with the new password."
