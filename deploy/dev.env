# dev.sidelinewire.com: NPM -> https://192.168.10.9:8040 (Traefik "dev" entrypoint)
NAMESPACE=football-analyst
SITE_HOST=dev.sidelinewire.com
ENTRYPOINT=dev
SITE_ENV=dev
DAILY_SCHEDULE="30 4 * * *"
WEEKLY_SCHEDULE="30 5 * * 2"
REFRESH_GAMEDAY_SCHEDULE="*/15 11-23 * * 4,5,6,0,1"
REFRESH_HOURLY_SCHEDULE="5 * * * *"
# Newsroom writes on dev until production takes over (one GPU: suspend dev's when prod's runs).
NEWSROOM_SCHEDULE="20 * * * *"
NEWSROOM_SUSPEND=false
NEWSROOM_AUTOPUBLISH=0   # 1: checked previews/recaps publish themselves; 0: all to /newsroom review
