# dev.sidelinewire.com: NPM -> https://192.168.10.9:8040 (Traefik "dev" entrypoint)
NAMESPACE=football-analyst
SITE_HOST=dev.sidelinewire.com
ENTRYPOINT=dev
SITE_ENV=dev
DAILY_SCHEDULE="30 4 * * *"
WEEKLY_SCHEDULE="30 5 * * 2"
REFRESH_GAMEDAY_SCHEDULE="*/15 11-23 * * 4,5,6,0,1"
REFRESH_HOURLY_SCHEDULE="5 * * * *"
# Newsroom: production writes the articles now; dev's hourly job is paused (the admin worker still runs).
NEWSROOM_SCHEDULE="20 * * * *"
NEWSROOM_SUSPEND=true
NEWSROOM_AUTOPUBLISH=0   # 1: checked previews/recaps publish themselves; 0: all to /admin review
# Contact address on /support and /privacy (the App Store listing links there).
SUPPORT_EMAIL=support@sidelinewire.com
