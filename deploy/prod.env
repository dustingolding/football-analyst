# sidelinewire.com: NPM -> https://192.168.10.9:8042 (Traefik "prod" entrypoint)
# Deployed from a checkout of main (~/football-analyst-prod) with its own database (football_prod).
NAMESPACE=sidelinewire
SITE_HOST=sidelinewire.com
ENTRYPOINT=prod
SITE_ENV=prod
DAILY_SCHEDULE="0 4 * * *"
WEEKLY_SCHEDULE="0 5 * * 2"
REQUIRE_BRANCH=main
# Offset from dev so the two environments' CPU-heavy steps never start together.
REFRESH_GAMEDAY_SCHEDULE="7,22,37,52 11-23 * * 4,5,6,0,1"
REFRESH_HOURLY_SCHEDULE="35 * * * *"
# Newsroom: enable (false) once production is the environment writing articles; then suspend dev's.
NEWSROOM_SCHEDULE="50 * * * *"
NEWSROOM_SUSPEND=false
NEWSROOM_AUTOPUBLISH=1   # 1: checked previews/recaps publish themselves; 0: all to /admin review
# Contact address on /support and /privacy (the App Store listing links there).
SUPPORT_EMAIL=
