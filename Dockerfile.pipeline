# Batch pipeline (ingest, ETL, Elo, features, models) run by the k8s CronJobs via pipeline.py.
# data/ and models/ are mounted from the host so caches and trained models persist.
FROM python:3.12-slim-bookworm

WORKDIR /app

COPY requirements.txt .
# xgboost's wheel pulls in NVIDIA NCCL (~290 MB) for multi-GPU training; this is CPU-only.
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall -y nvidia-nccl-cu12 nvidia-nccl-cu13 2>/dev/null; true

COPY *.py ./

# Same uid as the host user that owns data/ and models/.
RUN useradd --create-home --uid 1000 pipeline
USER pipeline

ENTRYPOINT ["python", "pipeline.py"]
CMD ["refresh"]
